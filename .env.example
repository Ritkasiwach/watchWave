# The app has no required secrets. See backend/.env.example and frontend/.env.example.
# Summary of every variable the project reads:
#
#   PORT              (backend)  port to listen on; hosting platforms set this for you. Default 3001
#   FRONTEND_URL      (backend)  comma-separated allowed origins, ONLY when the frontend is hosted separately
#   FRONTEND_DIST     (backend)  optional path to the built frontend. Default ../frontend/dist
#   VITE_BACKEND_URL  (frontend) backend URL, ONLY when the frontend is hosted separately (build-time!)
YOUTUBE_API_KEY=