# Port the server listens on (Render/Railway inject PORT automatically)
PORT=3001

# Comma-separated browser origins allowed to connect (CORS + Socket.IO).
# Only needed when the frontend is hosted on a DIFFERENT origin (Vercel/Netlify).
# If the backend serves the built frontend itself, this can stay as-is.
# Example: https://my-watch-party.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173
YOUTUBE_API_KEY=

# Optional: absolute path to the built frontend (defaults to ../frontend/dist)
# FRONTEND_DIST=
